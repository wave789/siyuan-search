{
  "name": "siyuan-search",
  "version": "1.5.2",
  "private": true,
  "type": "module",
  "description": "PyCharm-style in-document and workspace search for SiYuan",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "check": "tsc --noEmit",
    "check:package": "python3 scripts/check-package.py",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "npm run build && node --test tests/e2e/*.test.mjs",
    "package": "npm run check && npm run test && npm run build && python3 scripts/package.py && npm run check:package"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "siyuan": "1.2.8",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
